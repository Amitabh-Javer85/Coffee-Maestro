# Copy to .env in this directory. Never commit the populated file.
# Required for protected API routes, including local requests.
# Create locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=your-generated-local-api-secret-here

# Choose gemini or vertex_conversation.
ANSWER_PROVIDER=gemini

# Required only when ANSWER_PROVIDER=gemini. Vertex Conversation does not use
# GOOGLE_API_KEY; it authenticates with Application Default Credentials below.
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-api-key-here

# For vertex_conversation, supply identifiers from your own Dialogflow CX agent.
CONVERSATION_PROJECT_ID=
CONVERSATION_LOCATION=
CONVERSATION_AGENT_ID=
CONVERSATION_ENVIRONMENT_ID=
CONVERSATION_LANGUAGE_CODE=en
CONVERSATION_EVENT_NAME=RAG_ANSWER
CONVERSATION_TIMEOUT_SECONDS=30
# Empirically verified application-envelope ceiling, not a Google service limit.
# 16,384 bytes retained a tail fact; 16,385 bytes is rejected locally with HTTP 413.
CONVERSATION_MAX_PAYLOAD_BYTES=16384

# Google Cloud project for Vertex AI embeddings and (as a fallback) Conversation.
# Enable the APIs required by the selected provider in this project.
GCP_PROJECT_ID=your-gcp-project-id

# Legacy/general Vertex AI region setting; retained separately from the
# gemini-embedding-2 endpoint location configured below.
GCP_LOCATION=us-central1

# Vertex AI endpoint location for gemini-embedding-2. Supported values are
# global, us, and eu; default is global. See the model card:
# https://docs.cloud.google.com/gemini-enterprise-agent-platform/models/gemini/embedding-2
EMBEDDING_LOCATION=global

# Optional when Application Default Credentials are already configured; otherwise set
# an absolute path to a service-account JSON kept outside this repository. Grant the
# runtime identity only the invocation permissions needed for selected services.
# Leave blank to use ADC (for example, gcloud auth application-default login).
GOOGLE_APPLICATION_CREDENTIALS=

# Optional. Gemini model ID; code default shown. Google AI for Developers >
# Gemini API > Models: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash

# Optional. Text and image embedding model; default is gemini-embedding-2.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Optional document chunking settings; sizes are in characters.
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=50

# Optional retrieval/context settings. A snippet limit of 0 keeps full chunks.
CONTEXT_SNIPPET_MAX_LENGTH=0
TEXT_TOP_K=7
IMAGE_TOP_K=3
INGEST_BATCH_SIZE=50
MIN_IMAGE_SIZE_BYTES=20000
DIAGRAM_CAPTURE_PAGES=8

# Optional. Defaults to backend/extracted_images.
EXTRACTED_IMAGES_DIR=

# Required for persistent retrieval. Pinecone console > your project > API Keys.
# https://app.pinecone.io/ ; absent/blank selects an in-memory fallback only.
PINECONE_API_KEY=

# Optional. Choose an index name in Pinecone console > Database > Indexes.
# App creates a missing index using EMBEDDING_DIMENSIONS, cosine, AWS us-east-1.
# Use a dedicated index: reset deletes all vectors in its default namespace.
PINECONE_INDEX_NAME=google-rag-index

# Optional, default 0. Local test switch; set in the shell BEFORE pytest to opt
# into cloud calls. No provider account setting. Requires keys and indexed data.
RUN_LIVE_RAG_TESTS=0

# Optional built frontend directory; relative paths resolve from backend/.
# Leave blank to serve the normal frontend/dist or packaged build.
FRONTEND_DIST_DIR=
